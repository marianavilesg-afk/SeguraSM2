{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd, numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import joblib\n",
        "from google.colab import files\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.dummy import DummyClassifier\n",
        "from sklearn.metrics import (accuracy_score, classification_report, confusion_matrix,\n",
        "                             ConfusionMatrixDisplay, recall_score, f1_score)\n",
        "\n",
        "# 1. CARGAR (te abre un botón para elegir tu archivo CSV o Excel)\n",
        "subido = files.upload()\n",
        "ARCHIVO = list(subido.keys())[0]\n",
        "if ARCHIVO.lower().endswith((\".xlsx\", \".xls\")):\n",
        "    df = pd.read_excel(ARCHIVO)\n",
        "else:\n",
        "    df = pd.read_csv(ARCHIVO)\n",
        "print(ARCHIVO, df.shape)\n",
        "\n",
        "# 2. PREPARAR\n",
        "df.columns = [c.strip().upper() for c in df.columns]\n",
        "for c in df.select_dtypes(\"object\").columns:\n",
        "    df[c] = df[c].astype(str).str.strip().str.upper()\n",
        "\n",
        "df = df[df[\"MUNICIPIO_ACCIDENTE\"].str.contains(\"SANTA MARTA\")].copy()\n",
        "\n",
        "fecha = pd.to_datetime(df[\"FECHA_ACCIDENTE\"], errors=\"coerce\")\n",
        "if fecha.isna().mean() > 0.5:\n",
        "    fecha = pd.to_datetime(df[\"FECHA_ACCIDENTE\"], format=\"%m/%Y\", errors=\"coerce\")\n",
        "df[\"ANIO\"] = fecha.dt.year\n",
        "df[\"MES\"] = fecha.dt.month\n",
        "\n",
        "df[\"EDAD_VEHICULO\"] = pd.to_numeric(df[\"EDAD_VEHICULO\"], errors=\"coerce\").clip(lower=0)\n",
        "\n",
        "top_marcas = df[\"MARCA_VEHICULO\"].value_counts().head(15).index\n",
        "df[\"MARCA_AGRUP\"] = np.where(df[\"MARCA_VEHICULO\"].isin(top_marcas), df[\"MARCA_VEHICULO\"], \"OTRA\")\n",
        "\n",
        "df[\"TARGET\"] = (df[\"GRAVEDAD_ACCIDENTE\"] == \"CON MUERTOS\").astype(int)  # 1 = muertos\n",
        "df = df.dropna(subset=[\"ANIO\", \"MES\"])\n",
        "print(df.shape)\n",
        "print(df[\"GRAVEDAD_ACCIDENTE\"].value_counts())\n",
        "\n",
        "# 3. VARIABLES Y SEPARACIÓN (entrena 2022-2025, prueba 2026)\n",
        "FEATURES_CAT = [\"TIPO_VEHICULO\", \"MARCA_AGRUP\"]\n",
        "FEATURES_NUM = [\"EDAD_VEHICULO\", \"MES\"]\n",
        "X = df[FEATURES_CAT + FEATURES_NUM]\n",
        "y = df[\"TARGET\"]\n",
        "\n",
        "train = df[\"ANIO\"] <= 2025\n",
        "X_train, y_train = X[train], y[train]\n",
        "X_test, y_test = X[~train], y[~train]\n",
        "print(\"Entrenamiento:\", X_train.shape, \"| Prueba:\", X_test.shape)\n",
        "\n",
        "# 4. ENTRENAR\n",
        "prep = ColumnTransformer([\n",
        "    (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), FEATURES_CAT),\n",
        "    (\"num\", \"passthrough\", FEATURES_NUM),\n",
        "])\n",
        "\n",
        "modelos = {\n",
        "    \"Línea base (siempre heridos)\": DummyClassifier(strategy=\"most_frequent\"),\n",
        "    \"Regresión Logística\": LogisticRegression(max_iter=1000, class_weight=\"balanced\"),\n",
        "    \"Random Forest\": RandomForestClassifier(n_estimators=300, max_depth=8, min_samples_leaf=5,\n",
        "                                            class_weight=\"balanced\", random_state=42),\n",
        "}\n",
        "\n",
        "pipes, filas = {}, []\n",
        "for nombre, m in modelos.items():\n",
        "    p = Pipeline([(\"prep\", prep), (\"modelo\", m)]).fit(X_train, y_train)\n",
        "    pred = p.predict(X_test)\n",
        "    pipes[nombre] = p\n",
        "    filas.append({\n",
        "        \"Modelo\": nombre,\n",
        "        \"Exactitud\": round(accuracy_score(y_test, pred), 3),\n",
        "        \"Recall MUERTOS\": round(recall_score(y_test, pred, zero_division=0), 3),\n",
        "        \"F1 MUERTOS\": round(f1_score(y_test, pred, zero_division=0), 3),\n",
        "    })\n",
        "resultados = pd.DataFrame(filas)\n",
        "print(resultados)\n",
        "\n",
        "# 5. EVALUAR\n",
        "mejor = \"Random Forest\"\n",
        "p = pipes[mejor]\n",
        "pred = p.predict(X_test)\n",
        "print(classification_report(y_test, pred, target_names=[\"CON HERIDOS\", \"CON MUERTOS\"], zero_division=0))\n",
        "\n",
        "ConfusionMatrixDisplay(confusion_matrix(y_test, pred),\n",
        "                       display_labels=[\"CON HERIDOS\", \"CON MUERTOS\"]).plot(cmap=\"Blues\")\n",
        "plt.title(f\"Matriz de confusión — {mejor} (datos 2026)\")\n",
        "plt.show()\n",
        "\n",
        "resultados.set_index(\"Modelo\")[[\"Exactitud\", \"Recall MUERTOS\", \"F1 MUERTOS\"]].plot(kind=\"bar\", figsize=(9, 4))\n",
        "plt.title(\"Comparación de modelos (datos de prueba 2026)\")\n",
        "plt.ylabel(\"Valor\"); plt.xticks(rotation=15); plt.ylim(0, 1)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "rf = pipes[\"Random Forest\"]\n",
        "nombres = rf.named_steps[\"prep\"].get_feature_names_out()\n",
        "imp = pd.Series(rf.named_steps[\"modelo\"].feature_importances_, index=nombres).sort_values().tail(10)\n",
        "imp.plot(kind=\"barh\", figsize=(8, 4))\n",
        "plt.title(\"Top 10 variables más importantes — Random Forest\")\n",
        "plt.xlabel(\"Importancia\"); plt.tight_layout(); plt.show()\n",
        "\n",
        "# 6. PREDICCIONES Y ERRORES\n",
        "res = X_test.copy()\n",
        "res[\"REAL\"] = y_test.map({0: \"CON HERIDOS\", 1: \"CON MUERTOS\"})\n",
        "res[\"PREDICHO\"] = pd.Series(pred, index=X_test.index).map({0: \"CON HERIDOS\", 1: \"CON MUERTOS\"})\n",
        "res[\"PROB_MUERTOS\"] = p.predict_proba(X_test)[:, 1].round(2)\n",
        "print(res.head(10))\n",
        "print(\"\\nEJEMPLOS DE ERRORES:\")\n",
        "print(res[res[\"REAL\"] != res[\"PREDICHO\"]].head(5))\n",
        "\n",
        "# 7. GUARDAR MODELO (para el MVP)\n",
        "joblib.dump(pipes[\"Random Forest\"], \"modelo_seguraSM.joblib\")\n",
        "ejemplo = pd.DataFrame([{\"TIPO_VEHICULO\": \"MOTOCICLETA\", \"MARCA_AGRUP\": \"OTRA\", \"EDAD_VEHICULO\": 5, \"MES\": 12}])\n",
        "print(\"Prob. de CON MUERTOS:\", round(pipes[\"Random Forest\"].predict_proba(ejemplo)[0, 1], 2))"
      ],
      "metadata": {
